# From: https://docs.github.com/en/github/getting-started-with-github/configuring-git-to-handle-line-endings
# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.rs text eol=lf
*.toml text eol=lf
*.wgsl text eol=lf
*.wesl text eol=lf

# Declare files that will always have CRLF line endings on checkout.
*.sln text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.ttf binary

# Preserve the exact bytes published in checksum-verified crates.io snapshots.
editor/jackdaw/vendor/bevy-coupled/avian/** -text
editor/jackdaw/vendor/bevy-coupled/bevy-egui/** -text
editor/jackdaw/vendor/bevy-coupled/bevy-enhanced-input/** -text
editor/jackdaw/vendor/bevy-coupled/bevy-heavy/** -text
editor/jackdaw/vendor/bevy-coupled/bevy-monitors/** -text
editor/jackdaw/vendor/bevy-coupled/bevy-replicon/** -text
editor/jackdaw/vendor/bevy-coupled/bevy-transform-interpolation/** -text
editor/jackdaw/vendor/bevy-coupled/glam-matrix-extras/** -text
editor/jackdaw/vendor/bevy-coupled/leafwing-input-manager/** -text

# These two tracked Lightyear blobs intentionally use CRLF upstream.
editor/jackdaw/vendor/bevy-coupled/lightyear/crates/core/lightyear/CHANGELOG.md -text
editor/jackdaw/vendor/bevy-coupled/lightyear/crates/platform/web/CHANGELOG.md -text
